{
  "name": "browser-bridge",
  "version": "0.3.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm --filter @majuntao-1/browser-bridge-shared build && pnpm --filter @browser-bridge/extension typecheck && pnpm --filter @majuntao-1/browser-bridge-mcp-server typecheck",
    "dev:server": "pnpm --filter @majuntao-1/browser-bridge-mcp-server dev",
    "dev:daemon": "pnpm --filter @majuntao-1/browser-bridge-mcp-server dev:daemon",
    "build:extension": "pnpm --filter @browser-bridge/extension build",
    "build:site": "pnpm --filter @browser-bridge/ink-wuxia-site build",
    "dev:site": "pnpm --filter @browser-bridge/ink-wuxia-site dev",
    "smoke": "pnpm --filter @majuntao-1/browser-bridge-mcp-server smoke",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "bench": "vitest bench"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "typescript": "^5.4.5",
    "vitest": "^2.0.0"
  },
  "packageManager": "pnpm@9.0.0"
}
