{
  "manifest_version": 3,
  "name": "浏览器桥接",
  "version": "0.1.0",
  "description": "通过本地 MCP 服务把 AI 代理连接到用户的 Chrome 浏览器。",
  "permissions": ["activeTab", "tabs", "scripting", "storage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "浏览器桥接",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
